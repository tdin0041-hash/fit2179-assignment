{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#fdf6ec",
  "title": {
    "text": "Annual production for top 15 country (1990–2019)",
    "anchor": "start"
  },
  "width": 800,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/tdin0041-hash/fit2179-assignment/refs/heads/main/coffee_production.csv"
  },
  "transform": [
    {
      "aggregate": [
        {"op": "sum", "field": "Production_tonnes", "as": "Production_tonnes"}
      ],
      "groupby": ["Country", "Year"]
    },
    {
      "calculate": "datum.Country == 'Viet Nam' ? 'Vietnam' : datum.Country",
      "as": "Country_label"
    },
    {
      "window": [{"op": "sum", "field": "Production_tonnes", "as": "Total_production"}],
      "groupby": ["Country_label"],
      "frame": [null, null]
    },
    {
      "filter": {
        "field": "Country_label",
        "oneOf": [
          "Brazil", "Vietnam", "Colombia", "Indonesia",
          "Ethiopia", "India", "Mexico", "Guatemala",
          "Honduras", "Uganda", "Peru", "Côte d'Ivoire",
          "Costa Rica", "El Salvador", "Nicaragua"
        ]
      }
    }
  ],
  "mark": {"type": "rect"},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "title": "Year",
        "labelAngle": -90,
        "labelFontSize": 9,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "Country_label",
      "type": "nominal",
      "sort": {"field": "Total_production", "op": "max", "order": "descending"},
      "axis": {"title": null, "labelFontSize": 11}
    },
    "color": {
      "field": "Production_tonnes",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "scheme": "yelloworangebrown"
      },
      "legend": {
        "title": "Tonnes produced",
        "orient": "bottom",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "gradientLength": 300,
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {"field": "Country_label", "type": "nominal", "title": "Country"},
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {
        "field": "Production_tonnes",
        "type": "quantitative",
        "title": "Production (tonnes)",
        "format": ","
      }
    ]
  },
  "config": {
    "title": {
      "font": "Playfair Display",
      "fontWeight": "bold",
      "fontSize": 18,
      "subtitleFont": "Source Serif 4",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "color": "#3d1c02"
    },
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}
