{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#fdf6ec",
  "title": {
    "text": "Top 15 Importing Countries (1990-2019)",
    "anchor": "start"
  },
  "width": 800,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/tdin0041-hash/fit2179-assignment/refs/heads/main/coffee_import.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Import_tonnes": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "Country",
        "oneOf": [
          "United States of America", "Germany", "Italy", "Japan",
          "France", "Spain", "United Kingdom", "Belgium",
          "Netherlands", "Russian Federation", "Poland",
          "Switzerland", "Sweden", "Austria", "Finland"
        ]
      }
    },
    {
      "calculate": "datum.Country == 'United States of America' ? 'United States' : datum.Country == 'Russian Federation' ? 'Russia' : datum.Country == 'United Kingdom' ? 'UK' : datum.Country",
      "as": "Country_label"
    },
    {
      "window": [
        {"op": "sum", "field": "Import_tonnes", "as": "Total_import"}
      ],
      "groupby": ["Country_label"],
      "frame": [null, null]
    }
  ],
  "mark": {"type": "rect"},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {
        "title": "Year",
        "labelAngle": -90,
        "labelFontSize": 9,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "Country_label",
      "type": "nominal",
      "sort": {"field": "Total_import", "op": "max", "order": "descending"},
      "axis": {"title": null, "labelFontSize": 11}
    },
    "color": {
      "field": "Import_tonnes",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "scheme": "blues"
      },
      "legend": {
        "title": "Tonnes imported",
        "orient": "bottom",
        "direction": "horizontal",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "gradientLength": 300
      }
    },
    "tooltip": [
      {"field": "Country_label", "type": "nominal", "title": "Country"},
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {
        "field": "Import_tonnes",
        "type": "quantitative",
        "title": "Imports (tonnes)",
        "format": ","
      }
    ]
  },
  "config": {
    "title": {
      "font": "Playfair Display",
      "fontWeight": "bold",
      "fontSize": 18,
      "subtitleFont": "Source Serif 4",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "color": "#3d1c02"
    },
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}
