{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#fdf6ec",
  "title": {
    "text": "Global Coffee Production By Bean Type (1990-2019)",
    "anchor": "start"
  },
  "width": 800,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/tdin0041-hash/fit2179-assignment/refs/heads/main/coffee_production.csv"
  },
  "transform": [
    {
      "aggregate": [
        {"op": "sum", "field": "Production_tonnes", "as": "Production_tonnes"}
      ],
      "groupby": ["Year", "Coffee_type"]
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "axis": {
        "format": "d",
        "title": "Year",
        "grid": false,
        "tickCount": 6
      }
    },
    "y": {
      "field": "Production_tonnes",
      "type": "quantitative",
      "stack": true,
      "axis": {
        "title": "Production (tonnes)",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "format": "~s",
        "grid": true,
        "gridDash": [3, 3],
        "gridColor": "#e0e0e0"
      }
    },
    "color": {
      "field": "Coffee_type",
      "type": "nominal",
      "scale": {
        "domain": ["Arabica", "Robusta", "Mixed"],
        "range": ["#4e2a04", "#a0522d", "#d4956a"]
      },
      "legend": {
        "title": "Bean Type",
        "orient": "bottom",
        "direction": "horizontal",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {"field": "Coffee_type", "type": "nominal", "title": "Bean Type"},
      {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
      {
        "field": "Production_tonnes",
        "type": "quantitative",
        "title": "Production (tonnes)",
        "format": ","
      }
    ]
  },
  "config": {
    "title": {
      "font": "Playfair Display",
      "fontWeight": "bold",
      "fontSize": 18,
      "subtitleFont": "Source Serif 4",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "color": "#3d1c02"
    },
    "view": {"stroke": null}
  }
}
